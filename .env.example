# Draft generation (vision sidecar or n8n). Leave blank for demo mocks.
N8N_DRAFT_WEBHOOK_URL=

# Prefer direct Playwright publish worker (recommended).
# Example on Docker network: http://listing-publish:8092/publish
PUBLISH_WORKER_URL=

# Legacy n8n publish webhook (used only if PUBLISH_WORKER_URL is empty).
N8N_PUBLISH_WEBHOOK_URL=

# Public base URL of this app — used to build absolute photo URLs for the worker.
PUBLIC_APP_URL=https://listing-manager.srv1581423.hstgr.cloud

# Optional seller defaults forwarded on publish
SELLER_POSTCODE=DA3 7PS

# Optional shared secret. Sent as X-Webhook-Secret on outbound calls,
# and required on inbound POST /api/webhooks/n8n-draft-result when set.
N8N_WEBHOOK_SECRET=
